{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "autoIncrement": true,
      "env": {
        "WIDGET_HMAC_KEY": "@widget_hmac_key"
      }
    },
    "development": {
      "autoIncrement": true,
      "developmentClient": true,
      "env": {
        "WIDGET_HMAC_KEY": "@widget_hmac_key"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "alpha",
        "releaseStatus": "completed"
      }
    }
  }
}
